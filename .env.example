# Copy to .env and fill in. Mock mode runs with none of this set.

# --- Required for live runs ---
OPENROUTER_API_KEY=     # cheap worker models (plan / extract / rerank) + GPT-5.5 judge
TAVILY_API_KEY=         # web search / retrieval

# --- Optional ---
OPENAI_API_KEY=         # backup judge route (direct OpenAI); OpenRouter is the primary path

# --- Paths ---
# REF_DIR=                # dir of reference reports/scores for local comparisons (optional)

# --- Model overrides (defaults are sensible) ---
# DR_JUDGE_MODEL=openai/gpt-5.5
# DR_PATCH_MODEL=deepseek/deepseek-chat
